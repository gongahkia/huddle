{
  "name": "huddle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/main.ts",
    "start": "node dist/server.js",
    "bootstrap": "tsx scripts/bootstrap.ts",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "pnpm build && playwright test",
    "check:bundle": "tsx scripts/bundle-budget.ts",
    "bench:load": "tsx scripts/load.ts",
    "bench:browser": "playwright test tests/browser/performance.spec.ts --reporter=line",
    "import:pronto": "tsx scripts/import.ts",
    "examples": "tsx scripts/examples.ts",
    "test:docker": "tsx scripts/docker-smoke.ts",
    "test:package": "tsx scripts/package-smoke.ts",
    "backup": "tsx scripts/cli.ts backup"
  },
  "dependencies": {
    "@fastify/cors": "11.4.3",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "10.1.11",
    "fastify": "5.12.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@angular/common": "22.2.6",
    "@angular/compiler": "22.2.6",
    "@angular/core": "22.2.6",
    "@angular/platform-browser": "22.2.6",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.14.0",
    "jsdom": "31.0.1",
    "rollup": "4.68.3",
    "rollup-plugin-dts": "6.5.1",
    "rxjs": "7.8.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
